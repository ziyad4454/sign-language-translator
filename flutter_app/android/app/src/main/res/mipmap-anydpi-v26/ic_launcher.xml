<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon on Android 8 and later: the app's teal behind the white sign
     language symbol, cut to the phone's icon shape. The monochrome layer is used by
     themed icons on Android 13 and later. Drawn by tool/app_icon_test.dart. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
